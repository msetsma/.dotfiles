# Colors come from common/theme/catppuccin-mocha.toml (dotter template variables).
background = {{theme.base}}
foreground = {{theme.text}}
cursor-color = {{theme.rosewater}}
cursor-text = {{theme.base}}
selection-background = {{theme.surface2}}
selection-foreground = {{theme.text}}
palette = 0={{theme.surface1}}
palette = 1={{theme.red}}
palette = 2={{theme.green}}
palette = 3={{theme.yellow}}
palette = 4={{theme.blue}}
palette = 5={{theme.pink}}
palette = 6={{theme.teal}}
palette = 7={{theme.subtext1}}
palette = 8={{theme.surface2}}
palette = 9={{theme.red}}
palette = 10={{theme.green}}
palette = 11={{theme.yellow}}
palette = 12={{theme.blue}}
palette = 13={{theme.pink}}
palette = 14={{theme.teal}}
palette = 15={{theme.subtext0}}
window-decoration = true
font-family = "JetBrainsMono Nerd Font"
font-size = 14
confirm-close-surface = false
background-opacity = 1
background-blur = 15

# Add padding around the terminal content (in pixels)
window-padding-x = 5
window-padding-y = 5
macos-option-as-alt = true

# Global keybinding to summon a temp terminal
# https://ghostty.org/docs/config/reference#quick-terminal-size
quick-terminal-screen = main
quick-terminal-size = 1000px,700px
quick-terminal-animation-duration = .02
quick-terminal-position = center
quick-terminal-space-behavior = remain

# Keybinds
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r
keybind = cmd+shift+c=text:clip_last_output\n
